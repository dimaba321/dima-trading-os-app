{
  "name": "dima-trading-os",
  "version": "1.0.4",
  "description": "Dima Trading OS — Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "docx": "^9.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "jimp": "^1.6.1",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.dima.tradingos",
    "productName": "Dima Trading OS",
    "copyright": "Dima Trading OS 2026",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/app.ico",
      "sign": null,
      "verifyUpdateCodeSignature": false,
      "signingHashAlgorithms": null,
      "certificateSubjectName": null,
      "certificateSha1": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "public/app.ico",
      "uninstallerIcon": "public/app.ico",
      "installerSidebar": "build-resources/installer-sidebar.bmp",
      "uninstallerSidebar": "build-resources/installer-sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dima Trading OS",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "runAfterFinish": true
    },
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!data/positions.json",
          "!data/closed_trades.json",
          "!data/trades.db",
          "!data/settings.json",
          "!data/portfolio.json",
          "!data/stats.json",
          "!data/universe_additions.json",
          "!node_modules/.cache",
          "!node_modules/nodemon"
        ]
      }
    ]
  }
}
